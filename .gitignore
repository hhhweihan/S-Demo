# Editor / tooling
.claude/
.vscode/

# Build output — the aggregate root builds into ./build*, and each module can still be
# built standalone into its own build*/ dir. One generic rule covers both instead of
# enumerating every module by hand (which silently missed new modules before).
/build*/
CPP-Practice/**/build*/

# Stray local artifacts
CPP-Practice/raii/*.txt

# Compiler/OS junk that historically leaked into Test/ and xuanyuan_webserver/ (archived,
# not maintained) — keep it out for good instead of re-committing it on every checkout.
*.o
.DS_Store
